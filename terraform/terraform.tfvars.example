# Example project variables. In TerraForge set these in the dashboard instead:
# they are written to terraform.tfvars as quoted strings, replacing this file's
# copy. Every value is a string (numbers too), must not contain double quotes or
# backslashes, and all of them together must fit in 4 KB. All are optional.

# ---------------------------------------------------------------------------
# Custom domain (optional, set BOTH or NEITHER)
# ---------------------------------------------------------------------------

# Bare hostname, no scheme and no trailing slash.
# domain_name = "chat.pablo.one"

# ACM certificate covering domain_name. It sits on CloudFront, so it MUST be
# issued in us-east-1 whatever `region` is.
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/abc-123"

# Only set this if domain_name's zone lives in Route 53; otherwise create the
# record shown in the `dns_record` output at your DNS provider.
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# ---------------------------------------------------------------------------
# Core settings
# ---------------------------------------------------------------------------

# region       = "eu-central-1"          # S3 Vectors + Bedrock Titan v2 must both exist here
# project_name = "chat-pablo-one"        # prefix for every created resource
# site_url     = "https://www.pablo.one" # the site being indexed; also used in the chat persona

# Comma-separated, no spaces needed.
# cors_allowed_origins = "https://pablo.one,https://www.pablo.one,http://localhost,http://localhost:3000"

# ---------------------------------------------------------------------------
# Cost + abuse limits
# ---------------------------------------------------------------------------

# daily_budget_usd       = "0.5" # stop generating once the day's AI spend hits this
# ip_daily_message_limit = "50"  # max chat messages per public IP per day
# max_input_tokens       = "400" # reject a single message longer than this (estimated)

# ---------------------------------------------------------------------------
# Guardrail
# ---------------------------------------------------------------------------

# guardrail_blocked_message = "Thanks for your question! I'm happy to answer all your questions about me."

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------

# Changing the embedding model invalidates every stored vector; the next indexer
# run re-embeds the whole corpus.
# bedrock_model_id = "amazon.titan-embed-text-v2:0"
# chat_model_id    = "eu.amazon.nova-micro-v1:0"

# ---------------------------------------------------------------------------
# Functions
# ---------------------------------------------------------------------------

# api_lambda_memory      = "1024"        # MB
# api_lambda_timeout     = "30"          # seconds; keep <= 30 (API Gateway limit)
# indexer_lambda_memory  = "1024"        # MB
# indexer_lambda_timeout = "900"         # seconds
# indexer_schedule       = "rate(1 day)" # empty string = manual invokes only
# log_retention_days     = "14"
