node_modules/
.next/
.env.local

# indexer/data/*.json is COMMITTED on purpose: `terraform apply` embeds and loads
# those chunks into the vector index, so a fresh clone must already contain them.
# Re-generate them with `cd indexer && npm run ingest:all` (needs network access).

# Terraform local state
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan

# Terraform-managed by TerraForge: never commit real values.
# terraform.tfvars.example is committed.
terraform/terraform.tfvars
terraform/*.auto.tfvars

# Placeholder zip generated by the archive_file in lambda.tf.
terraform/.placeholder/

# Build artifacts, produced by the TerraForge buildspecs (frontends/web,
# functions/web) during CodeBuild — never committed.
web/.lambda/
web/.static/
web/.build-stamp
dist/
build/
out/

# TypeScript incremental build cache
*.tsbuildinfo
