node_modules/
.next/
.DS_Store
# Local env files hold real resource names / credentials. Examples are committed.
.env
.env.*
!.env.*.example
!.env.example
# functions/indexer/data/*.json is COMMITTED on purpose: the indexer function
# bundles it and loads it into the vector index. Re-generate it with
# `cd functions/indexer && npm run ingest:all` (needs network access).
# Terraform local state
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/backend_override.tf
# Project variables are set in the TerraForge dashboard: never commit real values.
# terraform.tfvars.example is committed.
terraform/terraform.tfvars
terraform/*.auto.tfvars
# Placeholder zip generated by the archive_file in functions.tf.
terraform/.placeholder/
# Build output, produced by the TerraForge buildspecs in CodeBuild.
dist/
build/
out/
# Local API dev server bundle (functions/api `npm run dev`).
.dev/
# Leftovers from the pre-monorepo layout (web/ at the repo root).
/web/
# TypeScript incremental build cache
*.tsbuildinfo
