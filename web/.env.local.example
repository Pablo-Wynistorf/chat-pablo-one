# Populated by Terraform:
#   cd terraform && terraform output -raw env_local > ../web/.env.local
AWS_REGION=eu-central-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/pablo-one-poc-dev
VECTOR_BUCKET=pablo-one-poc-abc123
VECTOR_INDEX=pages
BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0
CHAT_MODEL_ID=eu.amazon.nova-micro-v1:0
SITE_URL=https://www.pablo.one

# Guardrail (keeps the bot on-topic about Pablo) — created by Terraform:
GUARDRAIL_ID=xxxxxxxxxxxx
GUARDRAIL_VERSION=DRAFT

# Usage limits (DynamoDB-backed) — created by Terraform:
USAGE_TABLE=pablo-one-poc-usage
DAILY_BUDGET_USD=0.5        # stop generating once the day's AI spend hits this
IP_DAILY_LIMIT=50           # max chat messages per public IP per day
MAX_INPUT_TOKENS=400        # reject a single message longer than this (est. tokens)

# Optional greeting personalisation (see lib/visitor.ts).
# Geo prefers CloudFront-Viewer-* headers; these only apply to the IP-lookup fallback.
# GEO_API_URL=https://ipinfo.io/{ip}/json   # default; keyless, city-level. geojs.io is coarser
# GEO_TIMEOUT_MS=900        # cap on the lookup; result cached per IP for 6h
# VISITOR_HIDE_IP=true      # mask the last octet instead of showing the full IP

# Optional relevance floors:
# MIN_SCORE=0.25            # search dashboard relevance floor
# RAG_MIN_SCORE=0.2         # chatbot grounding relevance floor

# Optional token pricing overrides (USD per 1K tokens) for the cost calculator:
# CHAT_IN_PER_1K=0.000035
# CHAT_OUT_PER_1K=0.00014
# EMBED_PER_1K=0.00002
